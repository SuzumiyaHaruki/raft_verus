@@ -0,0 +1,362 @@
+//! DRAFT thin MadSim adapter, adapted conceptually from MadRaft's node/network controls.
+//! No election/vote decision is made here. The source of every injected request is the test.
+#[cfg(not(madsim))]
+compile_error!("Use the actual MadSim runtime with --cfg madsim");
+use madsim::{
+    net::{Endpoint, NetSim},
+    runtime::{Handle, Runtime},
+    time::{sleep, Duration},
+};
+use raft_verified::{madraft::VoteAction, *};
+use std::{
+    collections::BTreeMap,
+    net::SocketAddr,
+    sync::{Arc, Mutex},
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Scenario {
+    Nominal,
+    Barrier,
+    Edges,
+    BoundaryLog,
+    Faults,
+    Crash,
+    Failed,
+    Unknown,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub enum Record {
+    Receive(Message),
+    Decision(String, Observation),
+    Persist(OperationId, DurableState, bool),
+    Durable(OperationId, DurableState),
+    Complete(
+        OperationId,
+        CompletionOutcome,
+        Result<Option<Message>, InputError>,
+    ),
+    Send(Message),
+    Delivered(Message),
+    Checkpoint,
+    Loss(bool),
+    Duplicate,
+    Crash,
+    Timer(String),
+    BoundaryFixture,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub struct Trace {
+    pub records: Vec<Record>,
+    pub disk: Option<DurableState>,
+    pub final_state: Observation,
+}
+type Records = Arc<Mutex<Vec<Record>>>;
+type Disk = Arc<Mutex<BTreeMap<u64, DurableState>>>;
+fn log(records: &Records, r: Record) {
+    records.lock().unwrap().push(r);
+}
+fn address(id: u64) -> SocketAddr {
+    SocketAddr::from(([10, 0, 0, id as u8], 9000))
+}
+
+// Explicit codec only; unknown/truncated frames are errors, never votes.
+fn encode(m: &Message) -> Vec<u8> {
+    let (tag, a, b) = match m.body {
+        MessageBody::RequestVote {
+            last_index,
+            last_term,
+        } => (0, last_index, last_term),
+        MessageBody::VoteResponse { granted } => (1, u64::from(granted), 0),
+        _ => panic!("unsupported wire body"),
+    };
+    [
+        m.from,
+        m.to,
+        m.term,
+        m.rpc.incarnation,
+        m.rpc.sequence,
+        tag,
+        a,
+        b,
+    ]
+    .iter()
+    .flat_map(|n| n.to_le_bytes())
+    .collect()
+}
+fn decode(bytes: &[u8]) -> Option<Message> {
+    if bytes.len() != 64 {
+        return None;
+    }
+    let n: Vec<u64> = bytes
+        .chunks_exact(8)
+        .map(|x| u64::from_le_bytes(x.try_into().unwrap()))
+        .collect();
+    let body = match n[5] {
+        0 => MessageBody::RequestVote {
+            last_index: n[6],
+            last_term: n[7],
+        },
+        1 if n[6] <= 1 && n[7] == 0 => MessageBody::VoteResponse { granted: n[6] == 1 },
+        _ => return None,
+    };
+    Some(Message {
+        from: n[0],
+        to: n[1],
+        term: n[2],
+        rpc: OperationId {
+            incarnation: n[3],
+            sequence: n[4],
+        },
+        body,
+    })
+}
+pub fn request(from: u64, term: u64, last_index: u64, last_term: u64, sequence: u64) -> Message {
+    Message {
+        from,
+        to: 2,
+        term,
+        rpc: OperationId {
+            incarnation: 0,
+            sequence,
+        },
+        body: MessageBody::RequestVote {
+            last_index,
+            last_term,
+        },
+    }
+}
+async fn send(ep: &Endpoint, m: Message, records: &Records) {
+    log(records, Record::Send(m.clone()));
+    ep.send_to(address(m.to), 1, &encode(&m)).await.unwrap();
+}
+async fn serve(
+    core: Arc<Mutex<Node>>,
+    ep: Endpoint,
+    m: Message,
+    disk: Disk,
+    records: Records,
+    scenario: Scenario,
+) {
+    // At most two rounds: higher-term durability, then the retained RequestVote.
+    // Each round is requested by core output; the host never computes grant eligibility.
+    for _ in 0..2 {
+        log(&records, Record::Receive(m.clone()));
+        let action = {
+            let mut n = core.lock().unwrap();
+            let r = n.handle_request_vote(m.clone());
+            log(
+                &records,
+                Record::Decision(format!("{r:?}"), n.observe().clone()),
+            );
+            r
+        };
+        match action {
+            Err(_) => return,
+            Ok(VoteAction::Reply(reply)) => {
+                send(&ep, reply, &records).await;
+                return;
+            }
+            Ok(VoteAction::Persist { operation, retry }) => {
+                let image = core.lock().unwrap().observe().hard.clone();
+                log(&records, Record::Persist(operation, image.clone(), retry));
+                sleep(Duration::from_millis(10)).await;
+                let outcome = match scenario {
+                    Scenario::Failed => CompletionOutcome::NotPerformed,
+                    Scenario::Unknown => CompletionOutcome::Unknown,
+                    _ => CompletionOutcome::Success,
+                };
+                if outcome != CompletionOutcome::NotPerformed {
+                    // Tested/trusted atomic whole-image durable store outside the killed node.
+                    disk.lock().unwrap().insert(2, image.clone());
+                    log(&records, Record::Durable(operation, image));
+                }
+                if scenario == Scenario::Crash {
+                    log(&records, Record::Crash);
+                    Handle::current().kill("follower");
+                    return;
+                }
+                sleep(Duration::from_millis(
+                    if matches!(scenario, Scenario::Barrier | Scenario::Faults) {
+                        100
+                    } else {
+                        10
+                    },
+                ))
+                .await;
+                let result =
+                    core.lock()
+                        .unwrap()
+                        .finish_vote(operation, CompletionKind::Persist, outcome);
+                log(
+                    &records,
+                    Record::Complete(operation, outcome, result.clone()),
+                );
+                match result {
+                    Ok(Some(reply)) => {
+                        send(&ep, reply, &records).await;
+                        return;
+                    }
+                    Ok(None) if retry => continue,
+                    _ => return,
+                }
+            }
+        }
+    }
+}
+
+pub fn run(scenario: Scenario, seed: u64) -> Trace {
+    let rt = Runtime::with_seed_and_config(seed, Default::default());
+    rt.block_on(async {
+        let h = Handle::current();
+        let a = h
+            .create_node()
+            .name("injector-1")
+            .ip(address(1).ip())
+            .build();
+        let b = h.create_node().name("follower").ip(address(2).ip()).build();
+        let c = h
+            .create_node()
+            .name("injector-3")
+            .ip(address(3).ip())
+            .build();
+        let mut n = Node::feasibility_follower(2, vec![1, 2, 3]).unwrap();
+        let records: Records = Arc::new(Mutex::new(vec![]));
+        if scenario == Scenario::BoundaryLog {
+            let mut s = n.observe().clone();
+            s.hard.term = 2;
+            s.hard.log.push(Entry {
+                term: 2,
+                command: Command::Noop,
+            });
+            n = Node::from_observation(s);
+            log(&records, Record::BoundaryFixture);
+        }
+        let core = Arc::new(Mutex::new(n));
+        let disk: Disk = Arc::new(Mutex::new(BTreeMap::from([(
+            2,
+            core.lock().unwrap().observe().hard.clone(),
+        )])));
+        let (nc, ds, rs) = (core.clone(), disk.clone(), records.clone());
+        let server = b.spawn(async move {
+            let ep = Endpoint::bind(address(2)).await.unwrap();
+            loop {
+                let mut buf = [0; 65];
+                let (len, peer) = ep.recv_from(0, &mut buf).await.unwrap();
+                let m = decode(&buf[..len]).expect("invalid test wire input");
+                assert_eq!(address(m.from), peer, "host identity binding");
+                madsim::task::spawn(serve(
+                    nc.clone(),
+                    ep.clone(),
+                    m,
+                    ds.clone(),
+                    rs.clone(),
+                    scenario,
+                ));
+            }
+        });
+        // Bind injectors in their actual simulated node contexts.
+        let ep1 = a
+            .spawn(async { Endpoint::bind(address(1)).await.unwrap() })
+            .await
+            .unwrap();
+        let ep3 = c
+            .spawn(async { Endpoint::bind(address(3)).await.unwrap() })
+            .await
+            .unwrap();
+        for (node, ep) in [(a.clone(), ep1.clone()), (c.clone(), ep3.clone())] {
+            let rs = records.clone();
+            node.spawn(async move {
+                loop {
+                    let mut buf = [0; 65];
+                    let (len, peer) = ep.recv_from(1, &mut buf).await.unwrap();
+                    let m = decode(&buf[..len]).unwrap();
+                    assert_eq!(peer, address(2));
+                    log(&rs, Record::Delivered(m));
+                }
+            });
+        }
+        sleep(Duration::from_millis(20)).await;
+        let inputs = match scenario {
+            Scenario::Edges => vec![
+                request(1, 0, 0, 0, 1),
+                request(1, 0, 0, 0, 2),
+                request(3, 0, 0, 0, 3),
+                request(3, 2, 0, 0, 4),
+                request(1, 1, 0, 0, 5),
+                request(1, 2, 0, 0, 6),
+            ],
+            Scenario::BoundaryLog => vec![
+                request(1, 2, 99, 1, 1),
+                request(1, 2, 0, 2, 2),
+                request(1, 2, 1, 2, 3),
+            ],
+            _ => vec![request(1, 0, 0, 0, 1)],
+        };
+        if scenario == Scenario::Faults {
+            NetSim::current().update_config(|x| x.packet_loss_rate = 1.0);
+            log(&records, Record::Loss(true));
+            let ep = ep1.clone();
+            a.spawn(async move {
+                ep.send_to(address(2), 0, &encode(&request(1, 0, 0, 0, 99)))
+                    .await
+                    .unwrap();
+            })
+            .await
+            .unwrap();
+            sleep(Duration::from_millis(70)).await;
+            log(&records, Record::Checkpoint);
+            NetSim::current().update_config(|x| {
+                x.packet_loss_rate = 0.0;
+                x.send_latency = Duration::from_millis(30)..Duration::from_millis(31);
+            });
+            log(&records, Record::Loss(false));
+        }
+        for m in inputs {
+            let (node, ep) = if m.from == 1 {
+                (a.clone(), ep1.clone())
+            } else {
+                (c.clone(), ep3.clone())
+            };
+            let dup = scenario == Scenario::Faults;
+            let rs = records.clone();
+            node.spawn(async move {
+                ep.send_to(address(2), 0, &encode(&m)).await.unwrap();
+                if dup {
+                    log(&rs, Record::Duplicate);
+                    ep.send_to(address(2), 0, &encode(&m)).await.unwrap();
+                }
+            })
+            .await
+            .unwrap();
+            if scenario == Scenario::Barrier {
+                sleep(Duration::from_millis(50)).await;
+                log(&records, Record::Checkpoint);
+            }
+            sleep(Duration::from_millis(350)).await;
+        }
+        if scenario != Scenario::Crash {
+            let nc = core.clone();
+            let rs = records.clone();
+            b.spawn(async move {
+                sleep(Duration::from_millis(5)).await;
+                let r = nc.lock().unwrap().step(Event::ElectionTimeout {
+                    incarnation: 0,
+                    generation: 1,
+                });
+                log(&rs, Record::Timer(format!("{r:?}")));
+            })
+            .await
+            .unwrap();
+        }
+        server.abort();
+        let final_state = core.lock().unwrap().observe().clone();
+        let durable = disk.lock().unwrap().get(&2).cloned();
+        let records = std::mem::take(&mut *records.lock().unwrap());
+        Trace {
+            records,
+            disk: durable,
+            final_state,
+        }
+    })
+}
--- before/experiments/madraft-poc/tests/scenarios.rs
+++ after/experiments/madraft-poc/tests/scenarios.rs
@@ -0,0 +1,229 @@
+//! Independent expectations. All run() tests use the actual MadSim runtime and transport.
+use raft_host_madsim::{request, run, Record, Scenario, Trace};
+use raft_verified::{madraft::VoteAction, *};
+fn responses(t: &Trace) -> Vec<(u64, u64, bool)> {
+    t.records
+        .iter()
+        .filter_map(|r| match r {
+            Record::Delivered(m) => {
+                let request = t
+                    .records
+                    .iter()
+                    .find_map(|r| match r {
+                        Record::Receive(q) if q.rpc == m.rpc => Some(q),
+                        _ => None,
+                    })
+                    .expect("uncorrelated reply");
+                assert_eq!((m.from, m.to), (request.to, request.from));
+                match m.body {
+                    MessageBody::VoteResponse { granted } => {
+                        Some((m.rpc.sequence, m.term, granted))
+                    }
+                    _ => panic!("wrong reply"),
+                }
+            }
+            _ => None,
+        })
+        .collect()
+}
+fn ordered(t: &Trace) {
+    for (i, r) in t.records.iter().enumerate() {
+        if let Record::Send(m) = r {
+            if matches!(m.body, MessageBody::VoteResponse { granted: true }) {
+                let completion=t.records[..i].iter().rposition(|r|matches!(r,Record::Complete(_,CompletionOutcome::Success,Ok(Some(reply))) if reply == m)).expect("grant before matching completion");
+                let op = match &t.records[completion] {
+                    Record::Complete(op, _, _) => op,
+                    _ => unreachable!(),
+                };
+                assert!(t.records[..completion].iter().any(|r|matches!(r,Record::Durable(p,d) if p==op && d.term==m.term && d.voted_for==Some(m.to))));
+            }
+        }
+    }
+}
+fn emit(t: &Trace) {
+    println!("TRACE_BEGIN\n{t:#?}\nTRACE_END");
+}
+#[test]
+fn nominal_exchange() {
+    let t = run(Scenario::Nominal, 17);
+    emit(&t);
+    assert_eq!(responses(&t), vec![(1, 0, true)]);
+    assert!(t
+        .records
+        .iter()
+        .any(|r| matches!(r, Record::Timer(s) if s == "Err(UnsupportedEvent)")));
+    ordered(&t);
+}
+#[test]
+fn persistence_barrier() {
+    let t = run(Scenario::Barrier, 17);
+    emit(&t);
+    let i = t
+        .records
+        .iter()
+        .position(|r| matches!(r, Record::Checkpoint))
+        .unwrap();
+    assert!(!t.records[..i]
+        .iter()
+        .any(|r| matches!(r, Record::Send(_) | Record::Delivered(_))));
+    assert!(t.records[..i]
+        .iter()
+        .any(|r| matches!(r, Record::Durable(_, _))));
+    assert!(!t.records[..i]
+        .iter()
+        .any(|r| matches!(r, Record::Complete(_, _, _))));
+    assert_eq!(responses(&t), vec![(1, 0, true)]);
+    ordered(&t);
+}
+#[test]
+fn vote_edges() {
+    let t = run(Scenario::Edges, 17);
+    emit(&t);
+    assert_eq!(
+        responses(&t),
+        vec![
+            (1, 0, true),
+            (2, 0, true),
+            (3, 0, false),
+            (4, 2, true),
+            (5, 2, false),
+            (6, 2, false)
+        ]
+    );
+    ordered(&t);
+    assert_eq!(t.final_state.hard.voted_for, Some(3));
+    assert_eq!(
+        t.records
+            .iter()
+            .filter(|r| matches!(r, Record::Persist(_, _, true)))
+            .count(),
+        1
+    );
+}
+#[test]
+fn synthetic_log_boundary() {
+    let t = run(Scenario::BoundaryLog, 17);
+    emit(&t);
+    assert_eq!(
+        responses(&t),
+        vec![(1, 2, false), (2, 2, false), (3, 2, true)]
+    );
+    ordered(&t);
+}
+#[test]
+fn fault_loss_duplicate_delay_repeats() {
+    let a = run(Scenario::Faults, 771);
+    let b = run(Scenario::Faults, 771);
+    emit(&a);
+    emit(&b);
+    assert_eq!(a, b, "fixed seed must reproduce normalized protocol trace");
+    assert_eq!(responses(&a), vec![(1, 0, true)]);
+    let i = a
+        .records
+        .iter()
+        .position(|r| matches!(r, Record::Checkpoint))
+        .unwrap();
+    assert!(!a.records[..i]
+        .iter()
+        .any(|r| matches!(r, Record::Receive(_) | Record::Delivered(_))));
+    assert!(a
+        .records
+        .iter()
+        .any(|r| matches!(r,Record::Decision(s,_) if s.contains("Busy"))));
+    ordered(&a);
+}
+#[test]
+fn fault_crash_after_durable_before_callback() {
+    let t = run(Scenario::Crash, 17);
+    emit(&t);
+    assert!(t.records.iter().any(|r| matches!(r, Record::Crash)));
+    assert!(!t
+        .records
+        .iter()
+        .any(|r| matches!(r, Record::Complete(_, _, _) | Record::Send(_))));
+    assert_eq!(t.disk.unwrap().voted_for, Some(1));
+    assert!(responses(&Trace { disk: None, ..t }).is_empty());
+}
+#[test]
+fn fault_storage_failure_and_unknown_never_grant() {
+    for s in [Scenario::Failed, Scenario::Unknown] {
+        let t = run(s, 17);
+        emit(&t);
+        assert!(responses(&t).is_empty());
+        assert!(t.final_state.recovery_required);
+        if s == Scenario::Failed {
+            assert_eq!(t.disk.unwrap().voted_for, None);
+        }
+    }
+}
+#[test]
+fn core_boundary_errors_and_token_correlation() {
+    assert!(Node::feasibility_follower(2, vec![]).is_err());
+    assert!(Node::feasibility_follower(2, vec![1, 2, 1]).is_err());
+    assert!(Node::feasibility_follower(9, vec![1, 2, 3]).is_err());
+    let mut n = Node::feasibility_follower(2, vec![1, 2, 3]).unwrap();
+    assert_eq!(
+        n.handle_request_vote(request(9, 0, 0, 0, 1)),
+        Err(InputError::UnknownPeer)
+    );
+    let mut bad = request(1, 0, 0, 0, 1);
+    bad.to = 3;
+    assert_eq!(
+        n.handle_request_vote(bad),
+        Err(InputError::MalformedMessage)
+    );
+    let op = match n.handle_request_vote(request(1, 0, 0, 0, 1)).unwrap() {
+        VoteAction::Persist { operation, .. } => operation,
+        _ => panic!(),
+    };
+    for (p, k, error) in [
+        (
+            OperationId {
+                incarnation: 1,
+                ..op
+            },
+            CompletionKind::Persist,
+            InputError::StaleCompletion,
+        ),
+        (
+            OperationId { sequence: 99, ..op },
+            CompletionKind::Persist,
+            InputError::UnknownOperation,
+        ),
+        (op, CompletionKind::Send, InputError::WrongCompletionKind),
+    ] {
+        let before = n.observe().clone();
+        assert_eq!(n.finish_vote(p, k, CompletionOutcome::Success), Err(error));
+        assert_eq!(*n.observe(), before);
+    }
+    assert!(n
+        .finish_vote(op, CompletionKind::Persist, CompletionOutcome::Success)
+        .unwrap()
+        .is_some());
+    assert_eq!(
+        n.finish_vote(op, CompletionKind::Persist, CompletionOutcome::Success),
+        Err(InputError::UnknownOperation)
+    );
+    let term_op = match n.handle_request_vote(request(3, 2, 0, 0, 2)).unwrap() {
+        VoteAction::Persist { operation, retry } => {
+            assert!(retry);
+            operation
+        }
+        _ => panic!(),
+    };
+    assert_eq!(
+        n.finish_vote(op, CompletionKind::Persist, CompletionOutcome::Success),
+        Err(InputError::UnknownOperation)
+    );
+    assert_eq!(
+        n.finish_vote(term_op, CompletionKind::Persist, CompletionOutcome::Success),
+        Ok(None)
+    );
+    let mut boundary = n.observe().clone();
+    boundary.serial = u64::MAX;
+    n = Node::from_observation(boundary);
+    assert_eq!(
+        n.handle_request_vote(request(3, 2, 0, 0, 3)),
+        Err(InputError::ResourceExhausted)
+    );
+}

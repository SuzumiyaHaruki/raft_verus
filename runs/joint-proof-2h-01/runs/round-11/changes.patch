+verus! {
+// This invariant is for the partial registry segments, not full Raft safety.
+pub open spec fn seen(sent: Seq<segment_support::Envelope<Message>>, message: segment_support::Envelope<Message>) -> bool {
+    exists|n: int| 0 <= n < sent.len() && sent[n] == message
+}
+pub open spec fn runtime_invariant(s: RuntimeState, sent: Seq<segment_support::Envelope<Message>>) -> bool {
+    (forall|k: NodeKey| s.nodes.contains_key(k) ==> executable::valid(#[trigger] s.nodes[k]))
+    && (forall|j: int| 0 <= j < s.received.len() ==> #[trigger] seen(sent,s.received[j]))
+}
+pub proof fn prove_runtime_initial(s: RuntimeState)
+    requires runtime_initial(s),
+    ensures runtime_invariant(s,Seq::empty()), initial(view(s)),
+{ initial_registry_projection(s); }
+
+pub proof fn prove_runtime_step(s: RuntimeState, i: Input, t: RuntimeState, o: Output,
+    a: Seq<segment_support::Envelope<Message>>, b: Seq<segment_support::Envelope<Message>>)
+    requires runtime_invariant(s,a), runtime_step(s,i,t,o),
+        segment_support::exchange(a,receive(i),emit(o),b),
+    ensures runtime_invariant(t,b), step(view(s),i,view(t),o),
+{
+    match (i,o) {
+        (Input::Local(k,call), Output::Local(_,result)) => {
+            let h = executable::extend(s.nodes[k],call,t.nodes[k].states.last(),result);
+            assert(h == t.nodes[k]);
+            assert forall|j: NodeKey| t.nodes.contains_key(j) implies executable::valid(#[trigger] t.nodes[j]) by {
+                if j != k { assert(t.nodes[j] == s.nodes[j]); }
+            }
+            assert(view(t).nodes =~= view(s).nodes.insert(k,view(t).nodes[k]));
+        },
+        _ => { assert(view(t).nodes =~= view(s).nodes); },
+    }
+    assert(forall|k: NodeKey| t.nodes.contains_key(k) ==> executable::valid(#[trigger] t.nodes[k]));
+    assert forall|j: int| 0 <= j < t.received.len() implies #[trigger] seen(b,t.received[j]) by {
+        if j < s.received.len() {
+            assert(seen(a,s.received[j]));
+            let n = choose|n: int| 0 <= n < a.len() && a[n] == s.received[j];
+            assert(b[n] == a[n]);
+        } else {
+            match i {
+                Input::Delivery(_,d) => { assert(b[d.send as int] == d.message); },
+                _ => {},
+            }
+        }
+    }
+}
+}

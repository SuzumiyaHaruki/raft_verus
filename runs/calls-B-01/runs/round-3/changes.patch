+#[madsim::test]
+async fn snapshot_image_survives_interrupted_mirrors() {
+    let runtime = Handle::current();
+    let addr: SocketAddr = "10.6.0.1:1".parse().unwrap();
+    let host = create_node(&runtime, addr);
+    host.spawn(async move {
+        let (r, mut applied) = RaftHandle::new(vec![addr], 0).await;
+        sleep(Duration::from_secs(1)).await;
+        let proposed = r.start(b"command").await.unwrap();
+        match applied.next().await.unwrap() {
+            ApplyMsg::Command { index, data } => { assert_eq!(index, proposed.index); assert_eq!(data, b"command"); }
+            _ => panic!("expected committed command"),
+        }
+        r.snapshot(proposed.index, b"application-state").await.unwrap();
+        let next = r.inner.lock().unwrap().journal_next;
+        for generation in 0..next-1 {
+            assert!(fs::read(RaftHandle::record_name(generation)).await.unwrap().is_empty());
+        }
+        // Completed authoritative image, interrupted replacement of mirrors.
+        fs::File::create("state").await.unwrap();
+        fs::File::create("snapshot").await.unwrap();
+    }).await.unwrap();
+    kill(&runtime, addr);
+    let host = start_node(&runtime, addr);
+    host.spawn(async move {
+        let (_, mut applied) = RaftHandle::new(vec![addr], 0).await;
+        match applied.next().await.unwrap() {
+            ApplyMsg::Snapshot { index, data, .. } => { assert_eq!(index, 1); assert_eq!(data, b"application-state"); }
+            _ => panic!("expected restored snapshot"),
+        }
+    }).await.unwrap();
+}

+        let f=#[trigger] b.frames[i];f.change.node<b.nodes.len()
+            && f.change.before.config==b.nodes[f.change.node as int].state.config
+            && f.change.after.config==f.change.before.config
+    } by {if i<a.frames.len() {assert(b.frames[i]==a.frames[i]);}else{assert(b.frames[i].change.node==at);}}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent_report (DRAFT)",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "claimed_outcome",
    "summary",
    "changed_files",
    "attempted_obligation_ids",
    "commands_reported_by_agent",
    "proposed_spec_changes",
    "proposed_trust_changes",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "task_id": {
      "type": "string"
    },
    "claimed_outcome": {
      "enum": [
        "candidate_ready",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempted_obligation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_reported_by_agent": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_spec_changes": {
      "description": "Proposals to change protected behavioral requirements or assumptions. Editable implementation contracts, views and invariants belong in changed_files and summary instead.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_trust_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

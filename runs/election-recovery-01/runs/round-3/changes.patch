+            &&& promotion_allowed(f.change.before,f.votes)
+            &&& f.change.after==promotion_after(f.change.before,f.votes)
+            &&& forall|v:u64| #[trigger] f.votes.contains(v) ==> choice_for(b,v,f.change.node,f.change.after.state.term)

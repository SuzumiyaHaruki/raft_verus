+pub proof fn votes_step(before:Trace,after:Trace,event:Step)
+    requires network_inv(before),shape(before),enabled(before,event),after==step_after(before,event),
+        extends(before,after),shape(after),
+        (forall|i:int| 0<=i<after.sent.len() ==> sent_ok(after,i)),
+        (forall|i:int| 0<=i<after.replies.len() ==> reply_ok(after,i)),
+    ensures vote_sources(after),choice_sourced(after),

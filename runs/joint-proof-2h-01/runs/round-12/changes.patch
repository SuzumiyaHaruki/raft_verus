+// Upper use of the actual finish_received contract: its exact descriptor
+// becomes the response-submission segment without asserting host emission.
+pub proof fn actual_received_response_submission(k: implementation::NodeKey,
+    s: implementation::State, c: e::ReceivedContext, response: implementation::wire::ResponseSend)
+    requires c.valid(), k.node == c.inbound().recipient,
+        response.view().sender == c.inbound().recipient,
+        response.view().recipient == c.inbound().sender,
+        response.view().request == c.request(),
+    ensures implementation::step(s, implementation::Input::ResponseSubmission(k,response.view()),
+        implementation::State { submitted: s.submitted.push(implementation::response_envelope(k,response.view())), ..s },
+        implementation::Output::ResponseSubmission(k,response.view())),
+        implementation::response_envelope(k,response.view()).recipient == c.inbound().sender,
+        implementation::response_envelope(k,response.view()).body == implementation::Message::VoteReply(c.request(),response.view().reply),
+{}
+
 }

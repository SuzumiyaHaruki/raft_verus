+        with tempfile.TemporaryDirectory(prefix='raft tool override ') as location:
+            with patch.dict(os.environ, RAFT_TOOLCHAIN_ROOT=location):
+                config = load_config(ROOT)
+            selected = config['toolchain']['resolved']

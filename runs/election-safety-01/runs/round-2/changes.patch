+pub proof fn frames_step(before:Trace,after:Trace,event:Step)
+    requires network_inv(before),shape(before),enabled(before,event),after==step_after(before,event),
+        extends(before,after),
+    ensures elections_justified(after),
+        forall|i:int| 0<=i<after.frames.len() ==> (#[trigger] after.frames[i]).change.before.config==(Config{node:after.frames[i].change.node,members:after.nodes.len() as u64}),
